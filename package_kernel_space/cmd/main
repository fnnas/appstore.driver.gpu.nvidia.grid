#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SCRIPT_DIR}/common"

LEGACY_GROUPED_KERNEL_VER="6.18.18-trim"
CHROOT_BUILD_SCRIPT="${CHROOT_BUILD_SCRIPT:-${SCRIPT_DIR}/build_module_chroot}"

kernel_arch() {
    case "$(uname -m)" in
    x86_64 | amd64)
        echo "amd64"
        ;;
    aarch64 | arm64)
        echo "arm64"
        ;;
    *)
        return 1
        ;;
    esac
}

kernel_build_num() {
    uname -v | sed -n 's/.*#\([0-9][0-9]*\).*/\1/p' | head -n 1
}

kernel_package_version() {
    local kernel_ver="$1"
    local build_num="$2"
    local arch="$3"
    local build_tag

    case "${kernel_ver}" in
    "${LEGACY_GROUPED_KERNEL_VER}")
        if [[ ! "${build_num}" =~ ^[0-9]+$ ]]; then
            report_error "Unable to determine kernel build number for ${kernel_ver}"
            return 1
        fi

        if (( build_num < 570 )); then
            build_tag="427"
        elif (( build_num < 587 )); then
            build_tag="570"
        elif (( build_num < 717 )); then
            build_tag="587"
        else
            build_tag="717"
        fi

        echo "${kernel_ver}-${build_tag}-${arch}"
        ;;
    *)
        echo "${kernel_ver}-${arch}"
        ;;
    esac
}

firmware_source_dir() {
    echo "${PACKAGE_BASE}/app/firmware"
}

firmware_install_dir() {
    echo "/usr/lib/firmware/nvidia/${EXPECTED_DRIVER_VERSION}"
}

module_version() {
    local module_file="$1"

    if [[ ! -f "${module_file}" ]]; then
        return 1
    fi

    modinfo -F version "${module_file}" 2>/dev/null || modinfo "${module_file}" 2>/dev/null | awk '/^version:/ {print $2; exit}'
}

source_module_dir() {
    local arch
    local build_num
    local package_version

    arch="$(kernel_arch)" || {
        report_error "Unsupported architecture: $(uname -m)"
        return 1
    }

    build_num="$(kernel_build_num)"
    package_version="$(kernel_package_version "$(uname -r)" "${build_num}" "${arch}")" || return 1

    echo "${PACKAGE_BASE}/app/${PROJ_NAME}_${package_version}"
}

kernel_source_dir() {
    echo "${PACKAGE_BASE}/app/nvidia-kernel-source/kernel"
}

clear_chroot_module_payload() {
    local module_dir="$1"

    case "${module_dir}" in
    "${PACKAGE_BASE}/app/${PROJ_NAME}_"*)
        rm -rf -- "${module_dir}" || {
            report_error "Failed to clean NVIDIA chroot build output directory: ${module_dir}"
            return 1
        }
        ;;
    *)
        report_error "Refusing to clean unexpected NVIDIA chroot build output directory: ${module_dir}"
        return 1
        ;;
    esac
}

prepare_module_payload() {
    local built_version
    local kernel_ver
    local module_dir
    local source_dir

    kernel_ver="$(uname -r)"
    module_dir="$(source_module_dir)" || return 1

    if [[ -f "${module_dir}/nvidia.ko" ]]; then
        log_msg "Using prebuilt NVIDIA kernel modules from ${module_dir}"
        return 0
    fi

    source_dir="$(kernel_source_dir)"
    if [[ ! -f "${source_dir}/Makefile" ]]; then
        log_msg "No prebuilt NVIDIA modules or packaged kernel source found; continuing with the existing install checks"
        return 0
    fi

    if [[ -f "${CHROOT_BUILD_FAILURE_LOCK}" ]]; then
        report_error "A previous NVIDIA chroot build failed or was interrupted. Restart the device to clear /tmp, or manually delete ${CHROOT_BUILD_FAILURE_LOCK} before trying again."
        return 1
    fi

    create_chroot_build_failure_lock "${kernel_ver}" || return 1
    clear_chroot_module_payload "${module_dir}" || return 1
    log_msg "No prebuilt NVIDIA modules found for ${kernel_ver}; starting chroot build from ${source_dir}"

    if ! run_with_user_visible_log bash "${CHROOT_BUILD_SCRIPT}" "${kernel_ver}" "${source_dir}" "${module_dir}"; then
        clear_chroot_module_payload "${module_dir}" || true
        report_error "Failed to build NVIDIA kernel modules for ${kernel_ver} in chroot. The retry lock remains at ${CHROOT_BUILD_FAILURE_LOCK}."
        return 1
    fi

    if [[ ! -f "${module_dir}/nvidia.ko" ]]; then
        clear_chroot_module_payload "${module_dir}" || true
        report_error "NVIDIA chroot build completed without producing nvidia.ko for ${kernel_ver}. The retry lock remains at ${CHROOT_BUILD_FAILURE_LOCK}."
        return 1
    fi

    built_version="$(module_version "${module_dir}/nvidia.ko")" || {
        clear_chroot_module_payload "${module_dir}" || true
        report_error "Unable to read the chroot-built NVIDIA module version for ${kernel_ver}. The retry lock remains at ${CHROOT_BUILD_FAILURE_LOCK}."
        return 1
    }
    if [[ "${built_version}" != "${EXPECTED_DRIVER_VERSION}" ]]; then
        clear_chroot_module_payload "${module_dir}" || true
        report_error "Unexpected chroot-built NVIDIA module version: ${built_version}; expected: ${EXPECTED_DRIVER_VERSION}. The retry lock remains at ${CHROOT_BUILD_FAILURE_LOCK}."
        return 1
    fi

    clear_chroot_build_failure_lock || return 1
    log_msg "Stored chroot-built NVIDIA modules in ${module_dir}"
}

install_modules() {
    local src_dir
    local install_dir
    local alt_dir
    local alt_link
    local installed_version

    src_dir="$(source_module_dir)" || return 1
    install_dir="$(module_install_dir)"
    alt_dir="$(module_alternatives_dir)"
    alt_link="$(module_link)"

    if [[ ! -d "${src_dir}" ]]; then
        report_error "NVIDIA kernel module directory not found: ${src_dir}"
        return 1
    fi

    if [[ ! -f "${src_dir}/nvidia.ko" ]]; then
        report_error "nvidia.ko not found in ${src_dir}"
        return 1
    fi

    installed_version="$(module_version "${src_dir}/nvidia.ko")" || {
        report_error "Unable to read NVIDIA module version from ${src_dir}/nvidia.ko"
        return 1
    }

    if [[ "${installed_version}" != "${EXPECTED_DRIVER_VERSION}" ]]; then
        report_error "Unexpected NVIDIA module version in package: ${installed_version}; expected: ${EXPECTED_DRIVER_VERSION}"
        return 1
    fi

    log_msg "Installing NVIDIA modules from ${src_dir} to ${install_dir}"
    rm -rf "${install_dir}" || {
        report_error "Failed to remove old NVIDIA module directory: ${install_dir}"
        return 1
    }
    mkdir -p "${install_dir}" "${alt_dir}" || {
        report_error "Failed to create NVIDIA module directories: ${install_dir}, ${alt_dir}"
        return 1
    }
    cp -a "${src_dir}/." "${install_dir}/" || {
        report_error "Failed to copy NVIDIA modules from ${src_dir} to ${install_dir}"
        return 1
    }

    rm -f "$(module_root)/${MODULE_GROUP}" "${alt_link}" || {
        report_error "Failed to remove old NVIDIA module alternative link"
        return 1
    }
    ln -s "../${MODULE_VARIANT}" "${alt_link}" || {
        report_error "Failed to link ${alt_link} to ../${MODULE_VARIANT}"
        return 1
    }
    log_msg "Linked ${alt_link} -> ../${MODULE_VARIANT}"

    log_msg "Updating module dependencies"
    depmod || {
        report_error "Failed to update module dependencies with depmod"
        return 1
    }

    disable_nouveau || return 1

    log_msg "Updating initramfs"
    update-initramfs -u || {
        report_error "Failed to update initramfs"
        return 1
    }
}

install_firmware() {
    local src_dir
    local install_dir

    src_dir="$(firmware_source_dir)"
    install_dir="$(firmware_install_dir)"

    if [[ ! -d "${src_dir}" ]]; then
        report_error "NVIDIA firmware directory not found: ${src_dir}"
        return 1
    fi

    if ! find "${src_dir}" -mindepth 1 -type f -print -quit | grep -q .; then
        report_error "NVIDIA firmware files not found in ${src_dir}"
        return 1
    fi

    log_msg "Installing NVIDIA firmware from ${src_dir} to ${install_dir}"
    mkdir -p "${install_dir}" || {
        report_error "Failed to create NVIDIA firmware directory: ${install_dir}"
        return 1
    }
    cp -a "${src_dir}/." "${install_dir}/" || {
        report_error "Failed to copy NVIDIA firmware from ${src_dir} to ${install_dir}"
        return 1
    }
}

check_status() {
    local module_file
    local firmware_dir
    local version

    module_file="$(module_link)/nvidia.ko"
    firmware_dir="$(firmware_install_dir)"
    version="$(module_version "${module_file}")" || {
        report_error "NVIDIA module not installed at ${module_file}"
        return 1
    }

    if [[ "${version}" != "${EXPECTED_DRIVER_VERSION}" ]]; then
        report_error "Unexpected NVIDIA module version: ${version}; expected: ${EXPECTED_DRIVER_VERSION}"
        return 1
    fi

    if [[ ! -d "${firmware_dir}" ]]; then
        report_error "NVIDIA firmware directory not found: ${firmware_dir}"
        return 1
    fi

    if ! find "${firmware_dir}" -mindepth 1 -type f -print -quit | grep -q .; then
        report_error "NVIDIA firmware files not found in ${firmware_dir}"
        return 1
    fi

    return 0
}

main() {
    case "$1" in
    start)
        reset_user_visible_log
        uname -a
        log_msg "kernel_info $(uname -r) $(kernel_build_num)"
        check_root_free_space && install_firmware && prepare_module_payload && install_modules
        ;;
    stop)
        log_msg "Stop requested; module alternative link is restored by uninstall_init or upgrade_init"
        ;;
    status)
        if check_status; then
            return 0
        else
            return 3
        fi
        ;;
    *)
        report_error "Unsupported command: ${1:-}"
        return 1
        ;;
    esac
}

main "$@"
