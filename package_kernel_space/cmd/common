#!/bin/bash

LOG_FILE="${TRIM_PKGVAR:-/tmp}/info.log"
PACKAGE_BASE="${TRIM_APPDEST:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

PROJ_NAME="appstore.driver.gpu.nvidia.ko"
EXPECTED_DRIVER_VERSION="this_pack_nvidia_driver_version"
MODULE_GROUP="nvidia-gpu"
MODULE_VARIANT="nvidia-gpu-kernel-grid"
DEFAULT_MODULE_VARIANT="nvidia-gpu-proprietary"
MIN_ROOT_FREE_KB=$((2 * 1024 * 1024))
CHROOT_BUILD_FAILURE_LOCK="${CHROOT_BUILD_FAILURE_LOCK:-/tmp/appstore.driver.gpu.nvidia.ko-chroot-build.failed}"

log_msg() {
    local msg="$1"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ${msg}"
    mkdir -p "$(dirname "${LOG_FILE}")"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ${msg}" >> "${LOG_FILE}"
}

reset_user_visible_log() {
    if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then
        mkdir -p "$(dirname "${TRIM_TEMP_LOGFILE}")"
        : > "${TRIM_TEMP_LOGFILE}"
    fi
}

report_error() {
    local msg="$1"

    echo "$(date '+%Y-%m-%d %H:%M:%S') - ${msg}"
    mkdir -p "$(dirname "${LOG_FILE}")"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ${msg}" >> "${LOG_FILE}"

    if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then
        mkdir -p "$(dirname "${TRIM_TEMP_LOGFILE}")"
        printf "%s\n" "${msg}" >> "${TRIM_TEMP_LOGFILE}"
    fi
}

run_with_user_visible_log() {
    local command_status

    mkdir -p "$(dirname "${LOG_FILE}")"
    if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then
        mkdir -p "$(dirname "${TRIM_TEMP_LOGFILE}")"
        "$@" 2>&1 | tee -a "${LOG_FILE}" "${TRIM_TEMP_LOGFILE}"
    else
        "$@" 2>&1 | tee -a "${LOG_FILE}"
    fi
    command_status=${PIPESTATUS[0]}
    return "${command_status}"
}

create_chroot_build_failure_lock() {
    local kernel_ver="$1"

    if ! (
        set -o noclobber
        printf 'driver=%s\nkernel=%s\nstarted_at=%s\n' \
            "${EXPECTED_DRIVER_VERSION}" "${kernel_ver}" "$(date -Iseconds)" \
            > "${CHROOT_BUILD_FAILURE_LOCK}"
    ) 2>/dev/null; then
        report_error "Failed to create NVIDIA chroot build failure lock: ${CHROOT_BUILD_FAILURE_LOCK}"
        return 1
    fi
}

clear_chroot_build_failure_lock() {
    rm -f -- "${CHROOT_BUILD_FAILURE_LOCK}" || {
        report_error "Failed to remove NVIDIA chroot build failure lock: ${CHROOT_BUILD_FAILURE_LOCK}"
        return 1
    }
}

check_root_free_space() {
    local available_kb
    local available_mb
    local required_mb

    available_kb="$(df -Pk / 2>/dev/null | awk 'NR == 2 {print $4; exit}')"
    if [[ ! "${available_kb}" =~ ^[0-9]+$ ]]; then
        report_error "Unable to read root filesystem free space"
        return 1
    fi

    available_mb=$((available_kb / 1024))
    required_mb=$((MIN_ROOT_FREE_KB / 1024))

    if (( available_kb < MIN_ROOT_FREE_KB )); then
        report_error "Insufficient root filesystem free space: ${available_mb} MB available; need at least ${required_mb} MB"
        return 1
    fi

    log_msg "Root filesystem free space is ${available_mb} MB"
}

module_root() {
    local kernel_ver
    local base_ver
    local build_num
    local trim_alternatives
    local resolved_alternatives
    local usr_lib_root
    local usr_trim_root

    kernel_ver="$(uname -r)"
    base_ver="${kernel_ver%%-*}"
    build_num="$(uname -a | grep -o '#[0-9]\+' | tr -d '#' | head -n 1)"
    trim_alternatives="/lib/modules/${kernel_ver}/updates/trim/alternatives"
    usr_lib_root="/usr/lib/modules_trim/${kernel_ver}"
    usr_trim_root="/usr/trim/modules/${kernel_ver}"

    if [[ -e "${trim_alternatives}" || -L "${trim_alternatives}" ]]; then
        resolved_alternatives="$(readlink -f "${trim_alternatives}" 2>/dev/null)" || resolved_alternatives=""
        if [[ "${resolved_alternatives}" == */alternatives ]]; then
            dirname "${resolved_alternatives}"
            return 0
        fi
    fi

    if [[ "${build_num}" =~ ^[0-9]+$ ]] && \
        [[ "$(printf '%s\n' "6.18.18" "${base_ver}" | sort -V | head -n 1)" == "6.18.18" ]] && \
        (( build_num > 542 )); then
        echo "${usr_lib_root}"
        return 0
    fi

    if [[ "${build_num}" =~ ^[0-9]+$ ]]; then
        echo "${usr_trim_root}"
        return 0
    fi

    if [[ -d "${usr_lib_root}" ]]; then
        echo "${usr_lib_root}"
        return 0
    fi

    if [[ -d "${usr_trim_root}" ]]; then
        echo "${usr_trim_root}"
        return 0
    fi

    echo "${usr_lib_root}"
}

module_install_dir() {
    echo "$(module_root)/${MODULE_VARIANT}"
}

module_alternatives_dir() {
    echo "$(module_root)/alternatives"
}

module_link() {
    echo "$(module_alternatives_dir)/${MODULE_GROUP}"
}

restore_default_module_package() {
    local changed
    local current_target
    local default_dir
    local grid_dir
    local module_root
    local alt_dir
    local alt_link

    module_root="$(module_root)"
    alt_dir="$(module_alternatives_dir)"
    alt_link="$(module_link)"
    grid_dir="${module_root}/${MODULE_VARIANT}"
    default_dir="${module_root}/${DEFAULT_MODULE_VARIANT}"
    changed=0

    if [[ -d "${alt_dir}" ]]; then
        if [[ -L "${alt_link}" ]]; then
            current_target="$(readlink "${alt_link}" 2>/dev/null)" || current_target=""
            if [[ "${current_target}" == "../${MODULE_VARIANT}" ]]; then
                rm -f "${alt_link}" || {
                    report_error "Failed to remove NVIDIA GRID alternative link: ${alt_link}"
                    return 1
                }
                changed=1

                if [[ -d "${default_dir}" ]]; then
                    ln -s "../${DEFAULT_MODULE_VARIANT}" "${alt_link}" || {
                        report_error "Failed to restore ${alt_link} to ../${DEFAULT_MODULE_VARIANT}"
                        return 1
                    }
                    log_msg "Restored ${alt_link} -> ../${DEFAULT_MODULE_VARIANT}"
                else
                    log_msg "Default NVIDIA module directory not found: ${default_dir}; leaving ${alt_link} removed"
                fi
            else
                log_msg "Skipping NVIDIA alternative restore; ${alt_link} points to ${current_target:-unknown}, not ../${MODULE_VARIANT}"
            fi
        elif [[ -e "${alt_link}" ]]; then
            log_msg "Skipping NVIDIA alternative restore; ${alt_link} exists but is not a symlink"
        else
            log_msg "Skipping NVIDIA alternative restore; ${alt_link} does not exist"
        fi
    else
        log_msg "Skipping NVIDIA alternative restore; alternatives directory not found: ${alt_dir}"
    fi

    case "${module_root}" in
    /lib/modules/*/updates/trim | /usr/lib/modules_trim/* | /usr/trim/modules/*)
        ;;
    *)
        report_error "Refusing to clean unsupported NVIDIA module root: ${module_root}"
        return 1
        ;;
    esac
    if [[ "${module_root}" == "/" || -z "${module_root}" || "${grid_dir}" != */"${MODULE_VARIANT}" ]]; then
        report_error "Refusing to remove unsafe NVIDIA GRID module directory: ${grid_dir}"
        return 1
    fi
    if [[ -d "${grid_dir}" ]]; then
        rm -rf "${grid_dir}" || {
            report_error "Failed to remove NVIDIA GRID kernel module directory: ${grid_dir}"
            return 1
        }
        log_msg "Removed NVIDIA GRID kernel module directory: ${grid_dir}"
        changed=1
    else
        log_msg "Skipping NVIDIA GRID kernel module directory cleanup; not found: ${grid_dir}"
    fi

    if (( changed == 0 )); then
        log_msg "No NVIDIA GRID kernel module cleanup changes were needed"
        return 0
    fi

    depmod || {
        report_error "Failed to update module dependencies with depmod"
        return 1
    }
    update-initramfs -u || {
        report_error "Failed to update initramfs"
        return 1
    }
}

disable_nouveau() {
    local nouveau_blacklist_conf

    nouveau_blacklist_conf="/etc/modprobe.d/blacklist-nouveau.conf"

    log_msg "Disabling nouveau"
    mkdir -p "$(dirname "${nouveau_blacklist_conf}")" || {
        report_error "Failed to create nouveau blacklist config directory: $(dirname "${nouveau_blacklist_conf}")"
        return 1
    }

    printf "%s\n" \
        "blacklist nouveau" \
        "options nouveau modeset=0" > "${nouveau_blacklist_conf}" || {
        report_error "Failed to write nouveau blacklist config: ${nouveau_blacklist_conf}"
        return 1
    }
}
