#!/bin/bash

LOG_FILE="${TRIM_PKGVAR:-/tmp}/info.log"
PACKAGE_BASE="${TRIM_APPDEST:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

EXPECTED_DRIVER_VERSION="580.159.03"
NVIDIA_RUN_FILE="this_pack_grid_run"

log_msg() {
    local msg="$1"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ${msg}"
    mkdir -p "$(dirname "${LOG_FILE}")"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ${msg}" >> "${LOG_FILE}"
}

report_error() {
    local msg="$1"

    mkdir -p "$(dirname "${LOG_FILE}")"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ${msg}" >> "${LOG_FILE}"

    if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then
        mkdir -p "$(dirname "${TRIM_TEMP_LOGFILE}")"
        printf "%s\n" "${msg}" > "${TRIM_TEMP_LOGFILE}"
    fi
}

kernel_driver_version() {
    if [[ ! -r /proc/driver/nvidia/version ]]; then
        return 1
    fi

    sed -n 's/.*Kernel Module[[:space:]]\+\([0-9.]\+\).*/\1/p' /proc/driver/nvidia/version | head -n 1
}

check_kernel_driver_version() {
    local version

    version="$(kernel_driver_version)" || {
        report_error "Unable to read /proc/driver/nvidia/version"
        return 1
    }
    if [[ -z "${version}" ]]; then
        report_error "Unable to parse NVIDIA kernel driver version from /proc/driver/nvidia/version"
        return 1
    fi

    if [[ "${version}" != "${EXPECTED_DRIVER_VERSION}" ]]; then
        report_error "Unexpected NVIDIA kernel driver version: ${version}; expected: ${EXPECTED_DRIVER_VERSION}"
        return 1
    fi

    log_msg "NVIDIA kernel driver version is ${version}"
}

install_user_space_driver() {
    local run_file

    run_file="${PACKAGE_BASE}/app/${NVIDIA_RUN_FILE}"
    if [[ ! -f "${run_file}" ]]; then
        report_error "NVIDIA user space driver installer not found: ${run_file}"
        return 1
    fi

    chmod +x "${run_file}" || {
        report_error "Failed to make NVIDIA user space driver installer executable: ${run_file}"
        return 1
    }
    log_msg "Installing NVIDIA user space driver from ${run_file}"
    if ! "${run_file}" \
        --silent \
        --no-kernel-modules \
        --no-dkms \
        --disable-nouveau \
        --no-x-check \
        --no-nouveau-check \
        --no-questions \
        --ui=none >> "${LOG_FILE}" 2>&1; then
        report_error "NVIDIA user space driver installer failed; see ${LOG_FILE}"
        return 1
    fi
}

check_status() {
    check_kernel_driver_version
}

main() {
    case "$1" in
    start)
        check_kernel_driver_version && install_user_space_driver
        ;;
    stop)
        log_msg "Stop requested; NVIDIA user space driver is not removed by stop"
        ;;
    status)
        if check_status; then
            return 0
        else
            return 3
        fi
        ;;
    *)
        report_error "Unsupported command: ${1:-}"
        return 1
        ;;
    esac
}

main "$@"
