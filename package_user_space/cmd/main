#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SCRIPT_DIR}/common"

kernel_driver_version() {
    if [[ ! -r /proc/driver/nvidia/version ]]; then
        return 1
    fi

    awk '
        /Kernel Module/ {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^[0-9]+([.][0-9]+)+$/) {
                    print $i
                    exit
                }
            }
        }
    ' /proc/driver/nvidia/version
}

check_kernel_driver_version() {
    local version

    version="$(kernel_driver_version)" || {
        report_error "Unable to read /proc/driver/nvidia/version"
        return 1
    }
    if [[ -z "${version}" ]]; then
        report_error "Unable to parse NVIDIA kernel driver version from /proc/driver/nvidia/version"
        return 1
    fi

    if [[ "${version}" != "${EXPECTED_DRIVER_VERSION}" ]]; then
        report_error "Unexpected NVIDIA kernel driver version: ${version}; expected: ${EXPECTED_DRIVER_VERSION}"
        return 1
    fi

    log_msg "NVIDIA kernel driver version is ${version}"
}

install_user_space_driver() {
    local run_file

    run_file="$(nvidia_run_file_path)"
    if [[ ! -f "${run_file}" ]]; then
        report_error "NVIDIA user space driver installer not found: ${run_file}"
        return 1
    fi

    chmod +x "${run_file}" || {
        report_error "Failed to make NVIDIA user space driver installer executable: ${run_file}"
        return 1
    }
    log_msg "Installing NVIDIA user space driver from ${run_file}"
    if ! "${run_file}" \
        --silent \
        --no-kernel-modules \
        --no-dkms \
        --disable-nouveau \
        --no-x-check \
        --no-nouveau-check \
        --no-questions \
        --ui=none >> "${LOG_FILE}" 2>&1; then
        report_error "NVIDIA user space driver installer failed; see ${LOG_FILE}"
        return 1
    fi
}

install_nvlts() {
    local src_dir
    local install_dir
    local dropin_dir
    local dropin_file
    local gridd_conf_writer

    src_dir="$(nvlts_source_dir)"
    install_dir="/opt/nvlts"
    dropin_dir="/etc/systemd/system/nvidia-gridd.service.d"
    dropin_file="${dropin_dir}/nvlts.conf"
    gridd_conf_writer="${SCRIPT_DIR}/write_gridd_conf"

    if [[ ! -f "${src_dir}/nvlts" ]]; then
        report_error "NVLTS binary not found: ${src_dir}/nvlts"
        return 1
    fi

    if [[ ! -d "${src_dir}/configs" ]]; then
        report_error "NVLTS configs directory not found: ${src_dir}/configs"
        return 1
    fi

    if [[ ! -f "${gridd_conf_writer}" ]]; then
        report_error "gridd.conf writer not found: ${gridd_conf_writer}"
        return 1
    fi

    log_msg "Installing NVLTS from ${src_dir} to ${install_dir}"
    mkdir -p "${install_dir}" || {
        report_error "Failed to create NVLTS install directory: ${install_dir}"
        return 1
    }
    cp -f "${src_dir}/nvlts" "${install_dir}/nvlts" || {
        report_error "Failed to copy NVLTS binary to ${install_dir}"
        return 1
    }
    rm -rf "${install_dir}/configs" || {
        report_error "Failed to remove old NVLTS configs directory: ${install_dir}/configs"
        return 1
    }
    cp -a "${src_dir}/configs" "${install_dir}/configs" || {
        report_error "Failed to copy NVLTS configs to ${install_dir}/configs"
        return 1
    }
    chmod +x "${install_dir}/nvlts" || {
        report_error "Failed to make NVLTS executable: ${install_dir}/nvlts"
        return 1
    }

    chmod +x "${gridd_conf_writer}" || {
        report_error "Failed to make gridd.conf writer executable: ${gridd_conf_writer}"
        return 1
    }
    "${gridd_conf_writer}" >> "${LOG_FILE}" 2>&1 || {
        report_error "Failed to write /etc/nvidia/gridd.conf; see ${LOG_FILE}"
        return 1
    }

    mkdir -p "${dropin_dir}" || {
        report_error "Failed to create nvidia-gridd drop-in directory: ${dropin_dir}"
        return 1
    }
    printf "%s\n" \
        "[Service]" \
        "ExecStartPre=/opt/nvlts/nvlts -c /opt/nvlts/configs/vWS.json -g" > "${dropin_file}" || {
        report_error "Failed to write nvidia-gridd NVLTS drop-in: ${dropin_file}"
        return 1
    }

    log_msg "Reloading systemd and restarting nvidia-gridd"
    systemctl daemon-reload >> "${LOG_FILE}" 2>&1 || {
        report_error "Failed to reload systemd; see ${LOG_FILE}"
        return 1
    }
    systemctl enable nvidia-gridd >> "${LOG_FILE}" 2>&1 || {
        report_error "Failed to enable nvidia-gridd; see ${LOG_FILE}"
        return 1
    }
    systemctl restart nvidia-gridd >> "${LOG_FILE}" 2>&1 || {
        report_error "Failed to restart nvidia-gridd; see ${LOG_FILE}"
        return 1
    }
}

restart_dependent_services() {
    local service
    local services

    services=(
        sysinfo_service.service
        ai_manager.service
        mediasrv.service
        resmon_service.service
    )

    for service in "${services[@]}"; do
        if ! systemd_unit_exists "${service}"; then
            log_msg "Skipping missing ${service}"
            continue
        fi

        log_msg "Restarting ${service}"
        systemctl restart "${service}" >> "${LOG_FILE}" 2>&1 || {
            report_error "Failed to restart ${service}; see ${LOG_FILE}"
            return 1
        }
    done
}

check_status() {
    local nvidia_ml_library

    nvidia_ml_library="$(nvidia_ml_library_path)"
    if [[ -f "${nvidia_ml_library}" ]]; then
        return 0
    fi

    report_error "NVIDIA user space driver library not found: ${nvidia_ml_library}"
    return 1
}

main() {
    case "$1" in
    start)
        check_kernel_driver_version && install_user_space_driver && install_nvlts && restart_dependent_services
        ;;
    stop)
        log_msg "Stop requested; NVIDIA user space driver is not removed by stop"
        ;;
    status)
        if check_status; then
            return 0
        else
            return 3
        fi
        ;;
    *)
        report_error "Unsupported command: ${1:-}"
        return 1
        ;;
    esac
}

main "$@"
